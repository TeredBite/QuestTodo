<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="QuestTodoMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:QuestTodoMaui.Views"
    Title="QuestTodoMaui">

    <TabBar>
        <ShellContent
            Title="Задачи"
            ContentTemplate="{DataTemplate views:TasksPage}"
            Route="tasks" />

        <ShellContent
            Title="Скиллы"
            ContentTemplate="{DataTemplate views:SkillsPage}"
            Route="skills" />

        <ShellContent
            Title="Кампания"
            ContentTemplate="{DataTemplate views:CampaignPage}"
            Route="campaign" />
    </TabBar>

</Shell>
