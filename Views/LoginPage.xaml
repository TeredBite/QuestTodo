<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuestTodoMaui.Views.LoginPage"
             Title="Quest To-Do"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout Padding="32" Spacing="20" VerticalOptions="Center">
        <Label Text="🛡️" FontSize="74" HorizontalOptions="Center" />
        <Label Text="Quest To-Do" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#7F49B4" />
        <Label Text="Преврати дела в эпичные квесты" FontSize="16" HorizontalOptions="Center" TextColor="#666" />

        <Frame BackgroundColor="#f5f5f5" Padding="16" CornerRadius="12">
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding Error}" TextColor="#FF3B30" IsVisible="{Binding Error, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                       FontSize="14" />

                <Label Text="Имя пользователя" FontSize="14" FontAttributes="Bold" TextColor="#333" />
                <Entry Text="{Binding Username}" Placeholder="Введите имя"
                       BackgroundColor="White" TextColor="#333" FontSize="16" />

                <Label Text="Пароль" FontSize="14" FontAttributes="Bold" TextColor="#333" />
                <Entry Text="{Binding Password}" Placeholder="Введите пароль"
                       IsPassword="True"
                       BackgroundColor="White" TextColor="#333" FontSize="16" />

                <Label Text="Подтвердите пароль" FontSize="14" FontAttributes="Bold" TextColor="#333"
                       IsVisible="{Binding IsRegistering}" />
                <Entry Text="{Binding ConfirmPassword}" Placeholder="Повторите пароль"
                       IsPassword="True"
                       BackgroundColor="White" TextColor="#333" FontSize="16"
                       IsVisible="{Binding IsRegistering}" />

                <Button Text="Войти"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="#7F49B4" TextColor="White"
                        CornerRadius="8" Padding="16,10" FontSize="16"
                        IsVisible="{Binding IsRegistering, Converter={StaticResource InverseBoolConverter}}" />

                <Button Text="Зарегистрироваться"
                        Command="{Binding RegisterCommand}"
                        BackgroundColor="#34C759" TextColor="White"
                        CornerRadius="8" Padding="16,10" FontSize="16"
                        IsVisible="{Binding IsRegistering}" />
            </VerticalStackLayout>
        </Frame>

        <Button Text="Уже есть аккаунт? Войти"
                Command="{Binding ToggleModeCommand}"
                BackgroundColor="Transparent" TextColor="#7F49B4"
                FontSize="14"
                IsVisible="{Binding IsRegistering}" />

        <Button Text="Создать аккаунт"
                Command="{Binding ToggleModeCommand}"
                BackgroundColor="Transparent" TextColor="#7F49B4"
                FontSize="14"
                IsVisible="{Binding IsRegistering, Converter={StaticResource InverseBoolConverter}}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Color="#7F49B4" />
    </VerticalStackLayout>
</ContentPage>
