<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuestTodoMaui.Views.DataPage"
             Title="Данные">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="📁 Путь к данным" FontSize="18" FontAttributes="Bold" TextColor="White" />

            <Frame BackgroundColor="#f5f5f5" Padding="16" CornerRadius="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding DataPath}" FontSize="13" TextColor="#666"
                           FontAttributes="Bold" />
                    <Button Text="📂 Открыть папку" Command="{Binding OpenFolderCommand}"
                            BackgroundColor="#7F49B4" TextColor="White"
                            CornerRadius="8" Padding="16,10" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="📝 Содержимое appdata.json" FontSize="18" FontAttributes="Bold" TextColor="White" />

            <Frame BackgroundColor="#1e1e1e" Padding="16" CornerRadius="10">
                <ScrollView HeightRequest="400">
                    <Label Text="{Binding JsonContent}"
                           FontSize="11"
                           TextColor="#d4d4d4"
                           FontFamily="Consolas"
                           LineBreakMode="CharacterWrap" />
                </ScrollView>
            </Frame>

            <Button Text="🔄 Обновить" Command="{Binding LoadCommand}"
                    BackgroundColor="#34C759" TextColor="White"
                    CornerRadius="8" Padding="16,10" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="#7F49B4" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
