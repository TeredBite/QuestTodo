<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuestTodoMaui.Views.CampaignPage"
             Title="Настройки кампании">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Frame BackgroundColor="#f5f5f5" Padding="16" CornerRadius="10">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Название кампании" FontSize="18" FontAttributes="Bold" TextColor="#333" />
                    <Entry Text="{Binding Name}" Placeholder="Например: Киберпанк — Большой план" 
                           BackgroundColor="White" TextColor="#333" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#f5f5f5" Padding="16" CornerRadius="10">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Описание мира (сеттинг)" FontSize="18" FontAttributes="Bold" TextColor="#333" />
                    <Editor Text="{Binding Setting}" AutoSize="TextChanges" HeightRequest="120"
                            BackgroundColor="White" TextColor="#333" Placeholder="Опиши мир: эпоха, технологии, атмосфера..." />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#f5f5f5" Padding="16" CornerRadius="10">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Цель героя" FontSize="18" FontAttributes="Bold" TextColor="#333" />
                    <Editor Text="{Binding Goal}" AutoSize="TextChanges" HeightRequest="90"
                            BackgroundColor="White" TextColor="#333" Placeholder="Какую главную цель преследует герой?" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#f5f5f5" Padding="16" CornerRadius="10">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Настроение квестов" FontSize="18" FontAttributes="Bold" TextColor="#333" />
                    <Picker ItemsSource="{Binding AvailableTones}"
                            ItemDisplayBinding="{Binding Display}"
                            SelectedItem="{Binding SelectedTone}"
                            Title="Выберите настроение"
                            BackgroundColor="White" TextColor="#333" />
                    <Label Text="{Binding SelectedToneDescription}"
                           FontSize="12" TextColor="#666" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Сохранить" Command="{Binding SaveCommand}" 
                        BackgroundColor="#007AFF" TextColor="White" 
                        CornerRadius="8" Padding="20,10" FontSize="16" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" 
                                  Color="#007AFF" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

