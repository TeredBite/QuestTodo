<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuestTodoMaui.Views.TaskEditPage"
             Title="Новое дело">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="{Binding Error}" TextColor="#FF3B30" IsVisible="{Binding Error, Converter={StaticResource StringNotNullOrEmptyConverter}}" 
                   FontSize="14" />

            <Frame BackgroundColor="#f5f5f5" Padding="16" CornerRadius="10"
                   IsVisible="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Что нужно сделать?" FontSize="18" FontAttributes="Bold" TextColor="#333" />
                    <Entry Text="{Binding Title}" Placeholder="Например: Купить хлеб"
                           BackgroundColor="White" TextColor="#333" FontSize="16" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#f5f5f5" Padding="16" CornerRadius="10"
                   IsVisible="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Заметки (необязательно)" FontSize="18" FontAttributes="Bold" TextColor="#333" />
                    <Editor Text="{Binding Note}" AutoSize="TextChanges" HeightRequest="80"
                            BackgroundColor="White" TextColor="#333" FontSize="14"
                            Placeholder="Дополнительные детали, контекст..." />
                </VerticalStackLayout>
            </Frame>

            <Button Text="✨ Сгенерировать квест" Command="{Binding GenerateQuestCommand}"
                    BackgroundColor="#007AFF" TextColor="White"
                    CornerRadius="8" Padding="20,12" FontSize="16"
                    IsVisible="{Binding IsSaved, Converter={StaticResource InverseBoolConverter}}" />

            <Frame BackgroundColor="#E8F4FD" Padding="16" CornerRadius="10" IsVisible="{Binding QuestTitle, Converter={StaticResource StringNotNullOrEmptyConverter}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="📜 Сгенерированный квест" FontSize="16" FontAttributes="Bold" TextColor="#007AFF" />

                    <Frame BackgroundColor="White" Padding="12" CornerRadius="8">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding QuestTitle}" FontSize="16" FontAttributes="Bold" TextColor="#333" />
                            <Label Text="{Binding QuestText}" FontSize="14" TextColor="#333" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame BackgroundColor="#FFF9E6" Padding="12" CornerRadius="8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="⚠️ Что будет если отложить" FontSize="12" FontAttributes="Bold" TextColor="#856404" />
                            <Label Text="{Binding QuestStakes}" FontSize="13" TextColor="#333" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame BackgroundColor="#E8F5E9" Padding="12" CornerRadius="8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🎁 Награда" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" />
                            <Label Text="{Binding QuestReward}" FontSize="13" TextColor="#333" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame BackgroundColor="#F3E5F5" Padding="12" CornerRadius="8" IsVisible="{Binding QuestSkills, Converter={StaticResource StringNotNullOrEmptyConverter}}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🎯 Навыки" FontSize="12" FontAttributes="Bold" TextColor="#7B1FA2" />
                            <Label Text="{Binding QuestSkills}" FontSize="13" TextColor="#333" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame BackgroundColor="#FFF3E0" Padding="12" CornerRadius="8" IsVisible="{Binding QuestExperience, Converter={StaticResource StringNotNullOrEmptyConverter}}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🌟 Опыт" FontSize="12" FontAttributes="Bold" TextColor="#E65100" />
                            <Label Text="{Binding QuestExperience, StringFormat='+{0} XP'}" FontSize="13" TextColor="#333" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="💾 Сохранить" Command="{Binding SaveCommand}"
                        BackgroundColor="#34C759" TextColor="White"
                        CornerRadius="8" Padding="20,10" FontSize="16"
                        IsVisible="{Binding IsSaved, Converter={StaticResource InverseBoolConverter}}" />
                <Button Text="✅ Выполнено" Command="{Binding CompleteCommand}"
                        BackgroundColor="#FF9500" TextColor="White"
                        CornerRadius="8" Padding="20,10" FontSize="16"
                        IsVisible="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}" />
                <Button Text="🗑️ Удалить" Command="{Binding DeleteCommand}"
                        BackgroundColor="#FF3B30" TextColor="White"
                        CornerRadius="8" Padding="20,10" FontSize="16"
                        IsVisible="{Binding IsSaved}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                  Color="#007AFF" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

